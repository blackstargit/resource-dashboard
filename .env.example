PORT=8200
HOST=127.0.0.1
RELOAD=False
DISK_PATH=/

# -- Auth ---------------------------------------------------------------------
# The one dashboard user. Change ADMIN_PASSWORD and re-run `uv run python seed.py`
# to rotate it (that also logs out every existing session). Minimum 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-at-least-12-chars

# SQLite file holding the user and active sessions. Keep it on a volume.
DB_PATH=data/dashboard.db

# Session lifetime (7 days).
SESSION_TTL_SECONDS=604800

# Password-derivation cost. This is also what an eavesdropper pays per guess,
# so higher is safer -- but the browser computes it too, so it is a UX trade.
# 300k is roughly a second on a laptop. Changing it requires re-seeding.
PBKDF2_ITERATIONS=300000

# How far a client clock may drift from the server before requests are refused.
SIGNATURE_WINDOW_SECONDS=120

LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=300

# Terminating host processes from the browser. Off by default: it is the one
# destructive thing this app can do. Leave it false unless you need it.
ALLOW_PROCESS_KILL=false
